# Public URL of the deployed site, no trailing slash. Used for canonical URLs,
# hreflang alternates and Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the existing Namieri backend API (stenley.ge). Not called in Phase 1.
NEXT_PUBLIC_API_BASE_URL=

# Wolt venue page ("Namieri Saburtalo").
NEXT_PUBLIC_WOLT_URL=

# Social profiles.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/namieri.ge/
NEXT_PUBLIC_FACEBOOK_URL=

# "Message on Facebook" link (m.me/<page>). When empty it is derived from
# NEXT_PUBLIC_FACEBOOK_URL, and the button hides if that is empty too.
NEXT_PUBLIC_MESSENGER_URL=

# Wholesale (B2B) form destination, server-side only: each enquiry is POSTed
# here as JSON (Zapier, Make, n8n, a CRM, or the backend's endpoint). Without
# it, enquiries are logged in development and previews, and refused in
# production so none is silently lost. See lib/leads/submit.ts.
LEAD_WEBHOOK_URL=
# Optional bearer token sent with the webhook request.
LEAD_WEBHOOK_SECRET=
